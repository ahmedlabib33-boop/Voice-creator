# Copy this file to .env and paste your real values locally.
# .env is ignored by git. Never commit real keys.

# --- AI text engine: groq (default) or claude ---
TEXT_ENGINE=
GROQ_TEXT_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
CLAUDE_EFFORT=

# --- Voice generation (provider order: ElevenLabs -> Azure Egyptian -> Groq -> OpenAI -> Windows fallback) ---
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=
ELEVENLABS_VOICE_ID=

GROQ_API_KEY=
GROQ_TTS_MODEL=
GROQ_TTS_VOICE=

OPENAI_API_KEY=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=

# --- WhatsApp Cloud API (official Meta Graph API only) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=

# Optional: lock the recipient field to one number (Egyptian local 01xxxxxxxxx or E.164)
LOCKED_RECIPIENT_NUMBER=

# --- Optional Egyptian Arabic text refinement via local Ollama ---
OLLAMA_BASE_URL=
OLLAMA_MODEL=
